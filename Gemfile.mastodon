# Run Mastodon's bundle in *our* gem set: load upstream's Gemfile
# verbatim, then layer capybara-simulated on top.
# Activated via `BUNDLE_GEMFILE=Gemfile.mastodon`.
eval_gemfile File.expand_path('apps/mastodon/Gemfile', __dir__)

group :test do
  if (csim_path = ENV['CAPYBARA_SIMULATED_PATH'])
    gem 'capybara-simulated', path: File.expand_path(csim_path, __dir__)
  else
    gem 'capybara-simulated', github: 'ursm/capybara-simulated'
  end
  # Both JS engines installed so the suite can exercise either via
  # `CSIM_JS_ENGINE=v8|quickjs`. capybara-simulated.gemspec lists
  # neither as a hard dependency.
  # `Context#compile` + `Script#cached_data` + `Snapshot.load`
  # (rubyjs/mini_racer#413) drives `V8Runtime`'s cross-process
  # bytecode cache; all csim apps share the branch so the cache
  # lights up regardless of host.
  gem 'mini_racer', git: 'https://github.com/ursm/mini_racer.git', branch: 'feature/cached-data-411'
  gem 'quickjs', '>= 0.18'
end

# Stdlib-extracted gems csim_rspec.rb requires defensively (Rails 7.0's
# `active_support/logger_thread_safe_level.rb` chain). Mastodon already
# lists `csv` + `mutex_m`; backfill the rest so they're loadable on
# Ruby 3.4+ where they moved into bundled gems.
gem 'base64'
gem 'bigdecimal'
gem 'drb'
gem 'logger'
gem 'observer'
gem 'ostruct'
