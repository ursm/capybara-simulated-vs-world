#!/usr/bin/env bash
# Run Redmine's system tests through capybara-simulated. Args after
# the first are passed to `bin/rails test`.
#
#   bin/run-redmine
#   bin/run-redmine test/system/issues_test.rb
#   bin/run-redmine test/system/issues_test.rb:42
#
# Exits non-zero if any non-listed test fails OR any listed test
# unexpectedly passes (csim_minitest.rb's run-wrapper turns the
# latter into a synthetic Minitest::Assertion).

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
APP="$ROOT/apps/redmine"

cd "$APP"

# Stage configs the submodule doesn't ship. Symlink so editing the
# overlay during dev shows up immediately and `git status` inside
# the submodule doesn't drift.
if [ ! -e config/database.yml ]; then
  ln -s "$ROOT/config/redmine_database.yml" config/database.yml
fi

export BUNDLE_GEMFILE="$ROOT/Gemfile.redmine"
export RUBYOPT="-r$ROOT/support/csim_minitest.rb ${RUBYOPT:-}"

# CSIM_DRIVER must be set explicitly. We learned the hard way that a
# silent default makes "did I just compare simulated against itself?"
# the most common perf-measurement bug (CSIM_DRIVER='' falls back via
# bash :- to the default and you get sim-vs-sim instead of
# sim-vs-real). Require the value at the runner boundary.
if [ "${CSIM_DRIVER:-}" != "simulated" ] && [ "${CSIM_DRIVER:-}" != "real" ]; then
  echo "error: CSIM_DRIVER must be 'simulated' or 'real'" >&2
  exit 1
fi
export CSIM_EXPECTED_FAILURES="${CSIM_EXPECTED_FAILURES-$ROOT/lists/redmine.yml}"

# Default to running every system test if the caller didn't specify.
if [ "$#" -eq 0 ]; then
  set -- test/system
fi

# Pin Ruby on a per-app basis without dropping a `.ruby-version` into
# the (read-only-ish) submodule tree. Locally `mise exec` walks its
# own install of the right Ruby; in CI `actions/setup-ruby` already
# put the matching Ruby on PATH and mise isn't installed, so we just
# pass through.
RUBY_VERSION=3.4.9
if command -v mise >/dev/null 2>&1; then
  exec mise exec "ruby@$RUBY_VERSION" -- bundle exec bin/rails test "$@"
fi
exec bundle exec bin/rails test "$@"
