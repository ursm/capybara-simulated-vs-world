#!/usr/bin/env bash
# Run Discourse's RSpec system suite through capybara-simulated. Args
# after the first are passed to `bin/rspec`.
#
#   bin/run-discourse
#   bin/run-discourse spec/system/about_page_spec.rb
#   bin/run-discourse spec/system/about_page_spec.rb:42

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
APP="$ROOT/apps/discourse"

cd "$APP"

# Discourse pins `ruby "~> 3.4"`; mise's prebuilt 3.4.x line works.
RUBY_VERSION=3.4.6
NODE_VERSION=24.15.0

if command -v mise >/dev/null 2>&1; then
  ruby_wrap() { mise exec "ruby@$RUBY_VERSION" -- "$@"; }
  node_wrap() { mise exec "node@$NODE_VERSION" -- "$@"; }
else
  ruby_wrap() { "$@"; }
  node_wrap() { "$@"; }
fi

# Point Bundler at our wrapper Gemfile *before* any `bundle exec`
# step (asset build, rspec) so the upstream gem set + capybara-simulated
# is what gets activated. Without this the asset build picks up the
# ambient capybara-simulated dev Gemfile, which pins different openssl /
# nokogiri versions and crashes "already activated" mid-precompile.
export BUNDLE_GEMFILE="$ROOT/Gemfile.discourse"

# CSIM_DRIVER must be set explicitly. We learned the hard way that a
# silent default makes "did I just compare simulated against itself?"
# the most common perf-measurement bug (CSIM_DRIVER='' falls back via
# bash :- to the default and you get sim-vs-sim instead of
# sim-vs-real). Require the value at the runner boundary.
if [ "${CSIM_DRIVER:-}" != "simulated" ] && [ "${CSIM_DRIVER:-}" != "real" ]; then
  echo "error: CSIM_DRIVER must be 'simulated' or 'real'" >&2
  exit 1
fi
export CSIM_EXPECTED_FAILURES="${CSIM_EXPECTED_FAILURES-$ROOT/lists/discourse.yml}"

# Discourse's `config/database.yml` reads `DISCOURSE_DEV_DB` /
# `DISCOURSE_HOSTNAME` from env; default to local postgres so the
# test DB is reachable.
export DISCOURSE_HOSTNAME="${DISCOURSE_HOSTNAME:-localhost}"

# Discourse's frontend is an Ember CLI app under `app/assets/javascripts/discourse`
# plus several workspace packages; pnpm installs / builds them. Run once
# on first invocation; the sentinel skips next time.
#
# Upstream `lib/tasks/assets.rake` hardcodes `EMBER_ENV=production` for
# the JS build, which strips `data-test-*` attributes via
# ember-test-selectors. Discourse system specs query those selectors
# (`[data-test-email-log-row-id]` etc.), so we run the JS build
# directly with `EMBER_ENV=test` *first*, then call rake with
# `SKIP_EMBER_CLI_COMPILE=1` so it picks up the prebuilt JS and only
# does the Rails-side CSS / Sprockets work.
if [ ! -e tmp/csim-assets-built ]; then
  echo "==> Discourse JS bundle not built yet; running pnpm install + asset build (one-shot)"
  node_wrap corepack enable
  node_wrap corepack pnpm install --frozen-lockfile
  # Run the Ember build directly with EMBER_ENV=test so
  # ember-test-selectors preserves `data-test-*` attributes — upstream
  # `lib/tasks/assets.rake` hardcodes production. Then call rake with
  # `SKIP_EMBER_CLI_COMPILE=1` so the Rails-side CSS / Sprockets work
  # runs over the test-env JS dist we just produced.
  ( cd frontend/discourse && EMBER_ENV=test CI=1 node_wrap pnpm ember build )
  RAILS_ENV=test SKIP_EMBER_CLI_COMPILE=1 ruby_wrap bundle exec rake assets:precompile
  mkdir -p tmp && touch tmp/csim-assets-built
fi

# RUBYOPT only after the asset build so yarn-driven Ruby subshells
# (tailwindcss-rails etc.) don't get csim_rspec wired against their
# ambient Bundler.setup.
export RUBYOPT="-r$ROOT/support/csim_rspec.rb ${RUBYOPT:-}"

# V8 was crashing in `wasm::StackMemory::jslimit()` (NULL deref at 0x68)
# under sustained Ember work; mini_racer PR #416 (`fix-single-threaded-
# v8-thread`, rubyjs/mini_racer#415) hoists the JS→Ruby callback path
# off the Ruby caller thread and the SEGV is gone — 3/3 deterministic
# repro on stock 0.21.0, 0/3 on the PR branch. Default to V8 now;
# override with `CSIM_JS_ENGINE=quickjs` for the slower-but-fork-safe
# QuickJS path.
export CSIM_JS_ENGINE="${CSIM_JS_ENGINE:-v8}"

# Discourse's before-each calls `driven_by(:playwright_chrome)` or
# `:playwright_mobile_chrome`; csim_rspec's `CsimDrivenBy` override
# routes both to `:simulated`. Default to system specs.
if [ "$#" -eq 0 ]; then
  set -- spec/system
fi

if command -v mise >/dev/null 2>&1; then
  exec mise exec "ruby@$RUBY_VERSION" -- bundle exec bin/rspec "$@"
fi
exec bundle exec bin/rspec "$@"
