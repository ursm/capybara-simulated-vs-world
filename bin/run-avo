#!/usr/bin/env bash
# Run Avo's RSpec system suite through capybara-simulated. Args after
# the first are passed to `bin/rspec`.
#
#   bin/run-avo
#   bin/run-avo spec/system/avo/index_spec.rb
#   bin/run-avo spec/system/avo/index_spec.rb:42

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
APP="$ROOT/apps/avo"

cd "$APP"

# Per-app Ruby pin, matching Avo's `.ruby-version` (3.3.1) and its
# Appraisal gemfile (rails_8.0_ruby_3.3). 3.3.x is now installed via mise
# (3.3.11). Running on the 3.4 line broke instead: Ruby 3.4 dropped
# mutex_m / observer / etc. from the default gems, and Avo's ruby_3.3
# bundle doesn't carry them, so csim_rspec's stdlib `require`s LoadError'd.
RUBY_VERSION=3.3.11

# Avo's dummy app's Sprockets manifest reaches up into the gem's
# `app/assets/builds/`, which doesn't exist on a fresh clone — yarn
# builds for both the gem JS (`build:js`) and the dummy's custom JS
# (`build:custom-js`), plus the Tailwind output (`build:css`), all
# land there. Run once on first invocation; sentinel skips next time.
# Crucially the build runs *before* we export `RUBYOPT` — yarn shells
# out to ruby in a few places (rake-driven tailwind etc.) and a
# stray `RUBYOPT=-rcsim_rspec.rb` would force Bundler.setup against
# whatever ambient Ruby the shell-out picks up.
if command -v mise >/dev/null 2>&1; then
  ruby_wrap() { mise exec "ruby@$RUBY_VERSION" -- "$@"; }
else
  ruby_wrap() { "$@"; }
fi

# Mirror Avo's CI build pipeline (.github/workflows/system-tests.yml):
#   - `yarn install` at the gem root  (gem JS deps)
#   - `yarn install` inside spec/dummy (dummy-app JS deps — Avo's
#     custom-stream-actions, Stimulus controllers, etc. live here)
#   - `yarn build:js && build:css && build:custom-js` against the gem
#     directory; outputs land in `app/assets/builds/`. Run in
#     production mode like CI does so the bundles match the asset
#     pipeline the test app references.
# Crucially this runs *before* we export `RUBYOPT` — yarn shells out
# to ruby (tailwindcss-rails) and a stray `RUBYOPT=-rcsim_rspec.rb`
# would force `Bundler.setup` against whatever ambient Ruby the
# subshell picks up.
if [ ! -e tmp/csim-assets-built ]; then
  echo "==> Avo JS bundle not built yet; running yarn + esbuild (one-shot)"
  ruby_wrap yarn install --frozen-lockfile
  (cd spec/dummy && ruby_wrap yarn install --frozen-lockfile)
  export RAILS_ENV=production NODE_ENV=production
  ruby_wrap yarn build:js
  ruby_wrap yarn build:css
  ruby_wrap yarn build:custom-js
  unset RAILS_ENV NODE_ENV
  mkdir -p tmp && touch tmp/csim-assets-built
fi

export BUNDLE_GEMFILE="$ROOT/Gemfile.avo"

# Default the capybara-simulated source to the local checkout so the Gemfile
# matches the checked-in PATH lock. The real-driver path used to fall back to
# `github:` (CAPYBARA_SIMULATED_PATH unset), which didn't match the PATH lock →
# Bundler silently re-resolved, REWROTE the lock, and hit a pinned-Ruby default-gem
# conflict (e.g. json 2.19.7 vs lock 2.19.5). Always defaulting the PATH is what
# actually prevents that churn (resolution then matches the lock byte-for-byte).
export CAPYBARA_SIMULATED_PATH="${CAPYBARA_SIMULATED_PATH:-../capybara-simulated}"
# NOTE: BUNDLE_FROZEN is intentionally NOT set here (unlike the other runners).
# Gemfile.avo `eval_gemfile`s Avo's Appraisal gemfile, whose `gemspec` directive
# resolves to a path bundler 4.0 *serializes* as `apps/avo` but *frozen-checks*
# as `..` — an internal inconsistency that makes `ensure_equivalent_gemfile_and_
# lockfile` reject the lock no matter how it's regenerated. With the PATH default
# above the resolution already matches the lock (verified: bundler/setup leaves
# the lock unchanged), so frozen would only add a spurious failure here.
export RUBYOPT="-r$ROOT/support/csim_rspec.rb ${RUBYOPT:-}"

# CSIM_DRIVER must be set explicitly. We learned the hard way that a
# silent default makes "did I just compare simulated against itself?"
# the most common perf-measurement bug (CSIM_DRIVER='' falls back via
# bash :- to the default and you get sim-vs-sim instead of
# sim-vs-real). Require the value at the runner boundary.
if [ "${CSIM_DRIVER:-}" != "simulated" ] && [ "${CSIM_DRIVER:-}" != "real" ]; then
  echo "error: CSIM_DRIVER must be 'simulated' or 'real'" >&2
  exit 1
fi
export CSIM_EXPECTED_FAILURES="${CSIM_EXPECTED_FAILURES-$ROOT/lists/avo.yml}"

# Avo's `bin/rspec` shells out via Spring, which keeps an
# application-server process warm across runs. Spring caches the
# Rails autoload table from the first boot, so any later run with
# different gem paths (`Gemfile.avo` vs upstream `Gemfile`) tries
# to satisfy assets / requires through the cached one and fails on
# things like `Asset 'avo.base.css' was not declared`. Disable
# Spring outright — boot-time penalty is negligible vs the bundle
# install / asset build we already paid.
export DISABLE_SPRING=1

# Avo gates Pro features (e.g. menu editor, custom resources panel)
# behind `AVO_LICENSE_KEY`. Avo's own CI passes the literal
# `license_123` (it's a no-op key the gem accepts in test mode);
# without it many specs hit the "Pro license required" placeholder
# instead of the real component and mismatch upstream expectations.
export AVO_LICENSE_KEY="${AVO_LICENSE_KEY:-license_123}"

# `spec/rails_helper.rb` calls `driven_by :cuprite` directly; our
# `csim_rspec.rb`'s `CsimDrivenBy` override picks that up (cuprite
# is in `REAL_BROWSER_DRIVERS`) and routes to `:simulated`. No
# upstream patch needed.

# Avo's CI runs `spec/system/` only and excludes `:i18n` tests
# (`bundle exec rspec spec/system/ --tag=~i18n`). Mirror that so the
# pass count is comparable to the upstream baseline. Pass an
# explicit path / flags to override.
if [ "$#" -eq 0 ]; then
  set -- --tag '~i18n' spec/system
fi

if command -v mise >/dev/null 2>&1; then
  exec mise exec "ruby@$RUBY_VERSION" -- bundle exec bin/rspec "$@"
fi
exec bundle exec bin/rspec "$@"
