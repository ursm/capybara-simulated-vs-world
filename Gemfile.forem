# Run Forem's bundle in *our* gem set: load upstream's Gemfile
# verbatim, then layer capybara-simulated on top.
# Activated via `BUNDLE_GEMFILE=Gemfile.forem`.

# Forem's Gemfile reads `.ruby-version` and pins `ruby '3.3.0'` exactly,
# but mise's prebuilt Ruby line is 3.3.x where x > 0, and 3.3.0 itself
# no longer compiles cleanly against modern OpenSSL. Drop the `ruby`
# directive on read so Bundler accepts whichever 3.3 / 3.4 the caller
# invokes us with — the rest of the Gemfile is preserved as-is.
forem_gemfile = File.expand_path('apps/forem/Gemfile', __dir__)
src = File.read(forem_gemfile).sub(/^ruby\b.*$/, '# &')
instance_eval(src, forem_gemfile, 1)

group :test do
  if (csim_path = ENV['CAPYBARA_SIMULATED_PATH'])
    gem 'capybara-simulated', path: File.expand_path(csim_path, __dir__)
  else
    gem 'capybara-simulated', github: 'ursm/capybara-simulated'
  end
  # Both JS engines installed so the suite can exercise either via
  # `CSIM_JS_ENGINE=v8|quickjs`. capybara-simulated.gemspec lists
  # neither as a hard dependency.
  # Carries `Context#compile` / `Script#cached_data` / `Snapshot.load`
  # (cross-process bytecode cache) and `Context#compile_module` /
  # `Module#instantiate` / `#evaluate` / `Context#dynamic_import_resolver=`
  # (V8 native ES Module API). All csim apps share the branch so the
  # cache + native-module path light up regardless of host.
  gem 'quickjs', '>= 0.18'
  gem 'rusty_racer', path: '/home/ursm/Code/github.com/ursm/rusty_racer'
end

# Rails 7.0 doesn't `require` these explicitly anywhere — it relies on
# them being default-loaded from stdlib. Several were extracted into
# bundled gems in Ruby 3.4 and are no longer auto-required even on
# 3.3, so booting Rails fails with `uninitialized constant Logger` /
# similar without these in the bundle.
gem 'base64'
gem 'bigdecimal'
gem 'csv'
gem 'drb'
gem 'logger'
gem 'mutex_m'
gem 'observer'
gem 'ostruct'
