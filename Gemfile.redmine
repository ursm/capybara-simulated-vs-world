# Run Redmine's bundle in *our* gem set: load upstream's Gemfile
# verbatim, then layer capybara-simulated on top.
# Activated via `BUNDLE_GEMFILE=Gemfile.redmine`.
eval_gemfile File.expand_path('apps/redmine/Gemfile', __dir__)

group :test do
  gem 'capybara-simulated',
      path: File.expand_path('../capybara-simulated', __dir__)
  # Both JS engines installed so the suite can exercise either via
  # `CSIM_JS_ENGINE=v8|quickjs`. capybara-simulated.gemspec lists
  # neither as a hard dependency.
  gem 'mini_racer'
  gem 'quickjs', '0.17.0.pre'
  gem 'stackprof'
end
