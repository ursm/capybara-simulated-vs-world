# Run Redmine's bundle in *our* gem set: load upstream's Gemfile
# verbatim, then layer capybara-simulated on top.
# Activated via `BUNDLE_GEMFILE=Gemfile.redmine`.
eval_gemfile File.expand_path('apps/redmine/Gemfile', __dir__)

group :test do
  if (csim_path = ENV['CAPYBARA_SIMULATED_PATH'])
    gem 'capybara-simulated', path: File.expand_path(csim_path, __dir__)
  else
    gem 'capybara-simulated', github: 'ursm/capybara-simulated'
  end
  # Both JS engines installed so the suite can exercise either via
  # `CSIM_JS_ENGINE=v8|quickjs`. capybara-simulated.gemspec lists
  # neither as a hard dependency.
  # Carries `Context#compile` / `Script#cached_data` / `Snapshot.load`
  # (cross-process bytecode cache) and `Context#compile_module` /
  # `Module#instantiate` / `#evaluate` / `Context#dynamic_import_resolver=`
  # (V8 native ES Module API). All csim apps share the branch so the
  # cache + native-module path light up regardless of host.
  gem 'quickjs', '>= 0.18'
  gem 'rusty_racer', '~> 0.1.5'
  gem 'stackprof'
end
